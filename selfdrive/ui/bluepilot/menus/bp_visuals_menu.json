{
  "type": "base",
  "menuName": "BP Visuals",
  "menuIcon": "../assets/offroad/icon_visuals.png",
  "menuDescription": "BluePilot Visual Settings",
  "equalWidth": true,
  "iconPosition": "top",
  "groups": [
    {
      "groupName": "displayPreferencesGroup",
      "title": "Display Preferences:",
      "enableResetButton": false,
      "keepScreenAwake": true,
      "controls": [
        {
          "type": "toggle",
          "param": "BluepilotShowEnhancedOnroadUI",
          "title": "Enhanced Onroad UI",
          "desc": "Enable enhanced lane lines, road edges, and path rendering with glow effects and curve smoothing.",
          "hidden": false,
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        }
      ]
    },
    {
      "groupName": "pathAndModelGroup",
      "title": "Path and Model Display:",
      "enableResetButton": false,
      "controls": [
        {
          "type": "selection",
          "param": "CustomModelPathColor",
          "title": "Custom Model Path Color",
          "desc": "Customize the color of the driving path overlay",
          "requiresReboot": false,
          "hidden": false,
          "options": [
            { "name": "Stock", "value": "Stock" },
            { "name": "Rainbow", "value": "Rainbow" },
            { "name": "Blue", "value": "Blue" },
            { "name": "Green", "value": "Green" },
            { "name": "Purple", "value": "Purple" },
            { "name": "Orange", "value": "Orange" },
            { "name": "Red", "value": "Red" },
            { "name": "Cyan", "value": "Cyan" },
            { "name": "Yellow", "value": "Yellow" }
          ],
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        },
        {
          "type": "toggle",
          "param": "FordPrefShowAnimatedWheelAngle",
          "title": "Show Animated Steer Angle Icon",
          "desc": "Animates Comma icon based on steering angle.",
          "hidden": false,
          "conditions": {
            "allConditionsTrue": [
              { "git_remote": ["any"] },
              { "git_branch": [] }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "ShowBrakeStatus",
          "title": "Show Brake Status",
          "desc": "Changes the speed color to red when the brake is pressed.",
          "hidden": false,
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        },
        {
          "type": "toggle",
          "param": "BlindSpot",
          "title": "Show Blindspot Indicators",
          "desc": "Displays blindspot indicators on the road model.",
          "hidden": false,
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        },
        {
          "type": "toggle",
          "param": "ShowStopIndicatorOverlay",
          "title": "Show Stop Indicator Overlay",
          "desc": "Displays a stop indicator overlay when it detects a stop point.",
          "hidden": false,
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        },
        {
          "type": "toggle",
          "param": "ShowWideCameraAtLowSpeed",
          "title": "Show Wide Camera at Low Speed",
          "desc": "Show the wide camera at low speed.",
          "hidden": false,
          "conditions": {
            "git_remote": ["ford-op/sp-dev-c3"],
            "git_branch": []
          }
        }
      ]
    },
    {
      "groupName": "radarAndOverlayGroup",
      "title": "Radar and Overlay Settings:",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "FordPrefShowRadarLeadOverlay",
          "title": "Show Radar Lead Vehicle Overlay",
          "desc": "Displays radar data lead vehicle overlay.",
          "hidden": false,
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        },
        {
          "type": "segmented_control",
          "param": "FordPrefRadarOverlaySize",
          "title": "Radar Lead Vehicle Overlay Size",
          "desc": "Adjusts the size of the radar lead vehicle overlay",
          "hidden": false,
          "options": [
            { "name": "Small", "value": "1", "default": true },
            { "name": "Medium", "value": "2" },
            { "name": "Large", "value": "3" },
            { "name": "Ex-Large", "value": "4" }
          ],
          "conditions": {
            "allConditionsTrue": [
              { "git_remote": ["any"] },
              { "git_branch": [] },
              {
                "paramValueEquals": {
                  "FordPrefShowRadarLeadOverlay": "1"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "hybridDataGroup",
      "title": "Hybrid Vehicle Data:",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "FordPrefHybridDriveOverlay",
          "title": "Show Hybrid Electric Data Overlays",
          "desc": "Displays hybrid electric vehicle data.",
          "hidden": false,
          "conditions": {
            "allConditionsTrue": [
              { "paramValueEquals": { "FordPrefHevDataAvailable": "1" } },
              { "git_remote": ["any"] },
              { "git_branch": [] }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "FordPrefHybridBatteryOverlay",
          "title": "Show Hybrid Battery Data Overlays",
          "desc": "Displays hybrid battery data.",
          "hidden": false,
          "conditions": {
            "allConditionsTrue": [
              { "paramValueEquals": { "FordPrefHybridDriveOverlay": "1" } },
              { "paramValueEquals": { "FordPrefHevDataAvailable": "1" } },
              {
                "paramValueEquals": { "FordPrefHevBattDataAvailable": "1" }
              },
              { "git_remote": ["any"] },
              { "git_branch": [] }
            ]
          }
        },
        {
          "type": "segmented_control",
          "param": "FordPrefHybridDriveGaugeSize",
          "title": "Hybrid Drive Gauge Size",
          "desc": "Adjusts the size of the hybrid drive gauge",
          "hidden": false,
          "options": [
            { "name": "Small", "value": "1", "default": true },
            { "name": "Medium", "value": "2" },
            { "name": "Large", "value": "3" }
          ],
          "conditions": {
            "allConditionsTrue": [
              { "git_remote": ["any"] },
              { "git_branch": [] },
              {
                "paramValueEquals": {
                  "FordPrefHybridDriveOverlay": "1"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "metersAndTimersGroup",
      "title": "Meters and Timers:",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "ShowGForceMeter",
          "title": "Show G-Force Meter",
          "desc": "Displays a g-force meter when onroad.",
          "hidden": false,
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        },
        {
          "type": "toggle",
          "param": "StandstillTimer",
          "title": "Show Standstill Timer",
          "desc": "Displays a timer when the vehicle is in standstill.",
          "hidden": false,
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        }
      ]
    }
  ]
}
