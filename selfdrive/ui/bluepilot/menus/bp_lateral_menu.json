{
  "type": "base",
  "menuName": "BP Lateral",
  "menuIcon": "../assets/offroad/icon_steering.png",
  "menuDescription": "BluePilot Lateral Control Settings",
  "equalWidth": true,
  "iconPosition": "top",
  "groups": [
    {
      "groupName": "lateralControlsGroup",
      "title": "Lateral Controls:",
      "enableResetButton": true,
      "controls": [
        {
          "type": "toggle",
          "param": "FordPrefDisableBP_lat_UI",
          "title": "Disable BluePilot Lateral Controls",
          "desc": "Use stock openpilot lateral controls",
          "hidden": false,
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        },
        {
          "type": "toggle",
          "param": "FordPrefHumanTurnDetectionEnable",
          "title": "Enable Human Turn Detection",
          "desc": "Reset steering so you don't fight the wheel making manual turns.",
          "hidden": false,
          "conditions": {
            "allConditionsTrue": [
              { "git_remote": ["any"] },
              { "git_branch": [] },
              {
                "paramValueEquals": {
                  "FordPrefDisableBP_lat_UI": "0"
                }
              }
            ]
          }
        },
        {
          "type": "float",
          "param": "FordLatTuningLaneChgFactorHigh",
          "title": "Lane Change Factor High",
          "desc": "Adjust lane change curvature aggressiveness (lower = slower).",
          "hidden": false,
          "min": 0.0,
          "max": 1.0,
          "increment": 0.05,
          "division": 100.0,
          "conditions": {
            "allConditionsTrue": [
              { "git_remote": ["any"] },
              { "git_branch": [] },
              {
                "paramValueEquals": {
                  "FordPrefDisableBP_lat_UI": "0"
                }
              }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "FordLatTuningTuningCustomProfile",
          "title": "Use Custom Tuning Profile",
          "desc": "Use custom tuning profile for advanced lateral control",
          "hidden": false,
          "conditions": {
            "allConditionsTrue": [
              { "git_remote": ["any"] },
              { "git_branch": [] },
              {
                "paramValueEquals": {
                  "FordPrefDisableBP_lat_UI": "0"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "curvatureBlendGroup",
      "title": "Curvature Blend Settings:",
      "enableResetButton": false,
      "controls": [
        {
          "type": "float",
          "param": "FordLatTuningPCBlendRatio_low_C",
          "title": "Predicted Curvature Blend Ratio Low",
          "desc": "Adjust the blend ratio of predicted curvature in straightaways.",
          "hidden": false,
          "min": 0.0,
          "max": 1.0,
          "increment": 0.05,
          "division": 100.0,
          "conditions": {
            "allConditionsTrue": [
              { "git_remote": ["any"] },
              { "git_branch": [] },
              {
                "paramValueEquals": {
                  "FordLatTuningTuningCustomProfile": "1"
                }
              },
              {
                "paramValueEquals": {
                  "FordPrefDisableBP_lat_UI": "0"
                }
              }
            ]
          }
        },
        {
          "type": "float",
          "param": "FordLatTuningPCBlendRatio_high_C",
          "title": "Predicted Curvature Blend Ratio High",
          "desc": "Adjust the blend ratio of predicted curvature in curves.",
          "hidden": false,
          "min": 0.0,
          "max": 1.0,
          "increment": 0.05,
          "division": 100.0,
          "conditions": {
            "allConditionsTrue": [
              { "git_remote": ["any"] },
              { "git_branch": [] },
              {
                "paramValueEquals": {
                  "FordLatTuningTuningCustomProfile": "1"
                }
              },
              {
                "paramValueEquals": {
                  "FordPrefDisableBP_lat_UI": "0"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "lanePositioningGroup",
      "title": "Lane Positioning:",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "FordLatTuningEnableLanePositioning",
          "title": "Enable Advanced Lane Positioning",
          "desc": "Allows custom lane positioning and lanefull.",
          "hidden": false,
          "conditions": {
            "allConditionsTrue": [
              { "git_remote": ["any"] },
              { "git_branch": [] },
              {
                "paramValueEquals": {
                  "FordPrefDisableBP_lat_UI": "0"
                }
              }
            ]
          }
        },
        {
          "type": "float",
          "param": "FordLatTuningCustomPathOffset",
          "title": "In Lane Offset",
          "desc": "Adjusts lane position - left (-) / right (+)",
          "hidden": false,
          "min": -0.5,
          "max": 0.5,
          "increment": 0.01,
          "division": 100.0,
          "conditions": {
            "allConditionsTrue": [
              { "git_remote": ["any"] },
              { "git_branch": [] },
              {
                "paramValueEquals": {
                  "FordLatTuningEnableLanePositioning": "1"
                }
              },
              {
                "paramValueEquals": {
                  "FordPrefDisableBP_lat_UI": "0"
                }
              }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "FordLatTuningEnableLanefullMode",
          "title": "Enable Lane Full Mode",
          "desc": "Enable Auto Lanefull Mode similar to legacy SunnyPilot",
          "hidden": false,
          "conditions": {
            "allConditionsTrue": [
              { "git_remote": ["any"] },
              { "git_branch": [] },
              {
                "paramValueEquals": {
                  "FordLatTuningEnableLanePositioning": "1"
                }
              },
              {
                "paramValueEquals": {
                  "FordPrefDisableBP_lat_UI": "0"
                }
              }
            ]
          }
        },
        {
          "type": "float",
          "param": "FordLatTuningLCPIDGainUI",
          "title": "Low Curvature PID Gain",
          "desc": "Adjust the gain of the PID controller for low curvature",
          "hidden": false,
          "min": 0.0,
          "max": 10.0,
          "increment": 0.1,
          "division": 100.0,
          "conditions": {
            "allConditionsTrue": [
              { "git_remote": ["any"] },
              { "git_branch": [] },
              {
                "paramValueEquals": {
                  "FordLatTuningTuningCustomProfile": "1"
                }
              },
              {
                "paramValueEquals": {
                  "FordLatTuningEnableLanePositioning": "1"
                }
              },
              {
                "paramValueEquals": {
                  "FordPrefDisableBP_lat_UI": "0"
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
